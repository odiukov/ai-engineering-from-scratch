# Локальные настройки Claude Code не коммитим, а вот скиллы курса — да:
# без них /learn и /check-code не заработают у того, кто склонирует репо.
.claude/*
!.claude/skills/

# Личное. Всё, что ниже, у каждого своё — чтобы репо можно было отдать
# другому человеку, и он не увидел ни чужой прогресс, ни чужие решения.
LEARNING.md
LEARNING-*.md
learning-exercises/*/exercise.py
.pytest_cache/

# Generated by site/build.js on every Vercel deploy (buildCommand) — never
# commit, so they can't drift or drop URLs. Regenerated fresh from PHASES.
site/sitemap.xml
site/llms.txt
site/build-meta.js
book/_build/

# Lesson translations are generated to a separate `translations` branch, never
# main. The per-language README, however, is hand-authored and committed to main
# (see scripts/build_readme_i18n.py), so it is excluded from the ignore.
i18n/*/phases/
i18n/*/.cache/
i18n/*/.translate-cache.json
site/langs.js
